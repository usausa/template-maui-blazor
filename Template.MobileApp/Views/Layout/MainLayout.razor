@inherits LayoutComponentBase

<div class="content">
    @if (Startup.IsCompleted)
    {
        <ErrorBoundary @ref="errorBoundary">
            <ChildContent>
                @Body
            </ChildContent>
            <ErrorContent>
                <FluentStack Orientation="Orientation.Vertical"
                             HorizontalAlignment="HorizontalAlignment.Stretch"
                             VerticalGap="var(--spacingVerticalM)">
                    <FluentMessageBar Intent="MessageBarIntent.Error"
                                      Title="画面でエラーが起きました"
                                      AllowDismiss="false" />
                    <FluentButton Appearance="ButtonAppearance.Primary"
                                  OnClick="Recover">やり直す</FluentButton>
                </FluentStack>
            </ErrorContent>
        </ErrorBoundary>
    }
    else
    {
        <FluentStack Orientation="Orientation.Vertical"
                     HorizontalAlignment="HorizontalAlignment.Center"
                     VerticalAlignment="VerticalAlignment.Center"
                     VerticalGap="var(--spacingVerticalM)"
                     Height="100%">
            <FluentSpinner />
            <FluentText>Loading</FluentText>
        </FluentStack>
    }
</div>

<PageNavigator />

<FluentProviders />
