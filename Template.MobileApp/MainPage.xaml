<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:s="http://smart/maui"
             xmlns:mct="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:application="clr-namespace:Template.MobileApp"
             xmlns:shell="clr-namespace:Template.MobileApp.Shell"
             xmlns:behaviors="clr-namespace:Template.MobileApp.Behaviors"
             xmlns:markup="clr-namespace:Template.MobileApp.Markup"
             xmlns:views="clr-namespace:Template.MobileApp.Views"
             x:Class="Template.MobileApp.MainPage"
             x:DataType="{x:Type application:MainPageViewModel}"
             s:BindingContextResolver.Type="{x:Type application:MainPageViewModel}">

    <ContentPage.Resources>
        <ResourceDictionary>

            <!-- Converter -->

            <s:CompareToColorConverter x:Key="EqualToSelectColorConverter"
                                       Expression="{x:Static s:CompareExpressions.Equal}"
                                       TrueValue="{StaticResource PinkDefault}"
                                       FalseValue="{StaticResource GrayDefault}" />

        </ResourceDictionary>
    </ContentPage.Resources>

    <ContentPage.Behaviors>
        <s:AppLifecycleBehavior />
        <mct:StatusBarBehavior ApplyOn="OnBehaviorAttachedTo" StatusBarColor="White" StatusBarStyle="DarkContent" />
    </ContentPage.Behaviors>

    <!-- Content -->
    <Grid RowDefinitions="*,Auto,Auto">

        <!-- Overlay -->
        <Rectangle Grid.RowSpan="3"
                   shell:ShellProperty.BusyOverlay="True"
                   IsVisible="{Binding BusyState.IsBusy}" />

        <!-- Web -->
        <ContentView Grid.Row="0"
                     behaviors:BlazorWebViewBind.Controller="{Binding WebView}">
            <behaviors:BlazorWebViewBind.Template>
                <DataTemplate>
                    <BlazorWebView HostPage="wwwroot/index.html">
                        <BlazorWebView.RootComponents>
                            <RootComponent ComponentType="{x:Type views:Routes}"
                                           Selector="#app" />
                        </BlazorWebView.RootComponents>
                    </BlazorWebView>
                </DataTemplate>
            </behaviors:BlazorWebViewBind.Template>
        </ContentView>

        <!-- Web error -->
        <Grid Grid.Row="0"
              Style="{StaticResource WebErrorGrid}"
              IsVisible="{Binding IsWebError}">
            <VerticalStackLayout Style="{StaticResource WebErrorStack}">
                <Label Style="{StaticResource WebErrorTitleLabel}"
                       Text="{Binding WebErrorTitle}" />
                <Label Style="{StaticResource WebErrorMessageLabel}"
                       Text="{Binding WebErrorMessage}" />
                <Button Style="{StaticResource WebErrorButton}"
                        Command="{Binding RetryCommand}"
                        Text="再試行" />
                <Button Style="{StaticResource WebErrorSubButton}"
                        Command="{Binding UpdateWebViewCommand}"
                        IsVisible="{Binding CanUpdateWebView}"
                        Text="WebView を更新" />
            </VerticalStackLayout>
        </Grid>

        <!-- Bottom select -->
        <BoxView Grid.Row="1"
                 Style="{StaticResource BottomSelectSeparatorBoxView}" />

        <Grid Grid.Row="2"
              Style="{StaticResource BottomSelectGrid}"
              ColumnDefinitions="*,*,72,*,*">

            <Grid Grid.Column="0"
                  RowDefinitions="*,Auto"
                  behaviors:TouchOption.ClickCommand="{Binding PageCommand}"
                  behaviors:TouchOption.ClickCommandParameter="{x:Static views:SelectPage.Home}">
                <Image Grid.Row="0"
                       Style="{StaticResource BottomSelectImage}"
                       Source="{x:Static markup:AppIcons.Home}" />
                <Label Grid.Row="1"
                       Style="{StaticResource BottomSelectLabel}"
                       Text="ホーム"
                       TextColor="{Binding Selected, Converter={StaticResource EqualToSelectColorConverter}, ConverterParameter={x:Static views:SelectPage.Home}}" />
            </Grid>

            <Grid Grid.Column="1"
                  RowDefinitions="*,Auto"
                  behaviors:TouchOption.ClickCommand="{Binding PageCommand}"
                  behaviors:TouchOption.ClickCommandParameter="{x:Static views:SelectPage.Search}">
                <Image Grid.Row="0"
                       Style="{StaticResource BottomSelectImage}"
                       Source="{x:Static markup:AppIcons.Search}" />
                <Label Grid.Row="1"
                       Style="{StaticResource BottomSelectLabel}"
                       Text="検索"
                       TextColor="{Binding Selected, Converter={StaticResource EqualToSelectColorConverter}, ConverterParameter={x:Static views:SelectPage.Search}}" />
            </Grid>

            <Grid Grid.Column="3"
                  RowDefinitions="*,Auto"
                  behaviors:TouchOption.ClickCommand="{Binding PageCommand}"
                  behaviors:TouchOption.ClickCommandParameter="{x:Static views:SelectPage.Notifications}">
                <Image Grid.Row="0"
                       Style="{StaticResource BottomSelectImage}"
                       Source="{x:Static markup:AppIcons.Notifications}" />
                <Label Grid.Row="1"
                       Style="{StaticResource BottomSelectLabel}"
                       Text="お知らせ"
                       TextColor="{Binding Selected, Converter={StaticResource EqualToSelectColorConverter}, ConverterParameter={x:Static views:SelectPage.Notifications}}" />
                <Border Grid.Row="0" Grid.RowSpan="2"
                        Style="{StaticResource BottomSelectBadgeBorder}"
                        IsVisible="{Binding HasAccountAlert}">
                    <Label Style="{StaticResource BottomSelectBadgeLabel}"
                           Text="{Binding NotificationCount}" />
                </Border>
            </Grid>

            <Grid Grid.Column="4"
                  RowDefinitions="*,Auto"
                  behaviors:TouchOption.ClickCommand="{Binding PageCommand}"
                  behaviors:TouchOption.ClickCommandParameter="{x:Static views:SelectPage.Account}">
                <Image Grid.Row="0"
                       Style="{StaticResource BottomSelectImage}"
                       Source="{x:Static markup:AppIcons.Account}" />
                <Label Grid.Row="1"
                       Style="{StaticResource BottomSelectLabel}"
                       Text="アカウント"
                       TextColor="{Binding Selected, Converter={StaticResource EqualToSelectColorConverter}, ConverterParameter={x:Static views:SelectPage.Account}}" />
                <Border Grid.Row="0" Grid.RowSpan="2"
                        Style="{StaticResource BottomSelectBadgeBorder}"
                        IsVisible="{Binding HasAccountAlert}">
                    <Label Style="{StaticResource BottomSelectBadgeLabel}"
                           Text="!" />
                </Border>
            </Grid>

        </Grid>

        <!-- Center button -->
        <Button Grid.RowSpan="3"
                Style="{StaticResource CenterButton}"
                Command="{Binding PayCommand}"
                Text="支払い"
                ImageSource="{x:Static markup:AppIcons.Pay}" />

    </Grid>

</ContentPage>
