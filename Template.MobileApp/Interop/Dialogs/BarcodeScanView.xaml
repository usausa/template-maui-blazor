<?xml version="1.0" encoding="utf-8" ?>
<mct:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
           xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
           xmlns:s="http://smart/maui"
           xmlns:mct="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
           xmlns:scanner="clr-namespace:BarcodeScanning;assembly=BarcodeScanning.Native.Maui"
           xmlns:behaviors="clr-namespace:Template.MobileApp.Behaviors"
           xmlns:module="clr-namespace:Template.MobileApp.Interop.Dialogs"
           x:Class="Template.MobileApp.Interop.Dialogs.BarcodeScanView"
           x:DataType="{x:Type module:BarcodeScanViewModel}"
           s:BindingContextResolver.Type="{x:Type module:BarcodeScanViewModel}">

    <mct:Popup.Resources>
        <ResourceDictionary>

            <Style x:Key="ScanCancelButton"
                   TargetType="Button">
                <Setter Property="Margin" Value="12" />
                <Setter Property="HeightRequest" Value="44" />
                <Setter Property="CornerRadius" Value="0" />
                <Setter Property="BorderWidth" Value="1" />
                <Setter Property="BorderColor" Value="{StaticResource PinkDefault}" />
                <Setter Property="BackgroundColor" Value="White" />
                <Setter Property="TextColor" Value="{StaticResource PinkDefault}" />
                <Setter Property="FontSize" Value="16" />
            </Style>

        </ResourceDictionary>
    </mct:Popup.Resources>

    <!-- Content -->
    <Grid RowDefinitions="*,Auto">
        <scanner:CameraView Grid.Row="0"
                            HeightRequest="{x:Static module:DialogSize.LargeWidth}"
                            behaviors:BarcodeBind.Controller="{Binding Controller}"
                            OnDetectionFinishedCommand="{Binding DetectCommand}" />
        <Button Grid.Row="1"
                Style="{StaticResource ScanCancelButton}"
                Command="{Binding CancelCommand}"
                Text="キャンセル" />
    </Grid>

</mct:Popup>
