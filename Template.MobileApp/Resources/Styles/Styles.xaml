<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    xmlns:s="http://smart/maui"
                    xmlns:behaviors="clr-namespace:Template.MobileApp.Behaviors"
                    xmlns:converters="clr-namespace:Template.MobileApp.Converters">

    <!-- ================================================================================ -->
    <!-- Converter -->
    <!-- ================================================================================ -->

    <!-- Basic -->

    <s:ReverseConverter x:Key="ReverseConverter" />

    <s:NullToBoolConverter x:Key="NotEmptyConverter"
                           HandleEmptyString="True"
                           NullValue="False"
                           NonNullValue="True" />

    <s:CompareToBoolConverter x:Key="GreaterThanToBoolConverter"
                              Expression="{x:Static s:CompareExpressions.GreaterThan}" />

    <!-- Application -->

    <converters:QrImageSourceConverter x:Key="QrImageSourceConverter" />

    <!-- ================================================================================ -->
    <!-- Main -->
    <!-- ================================================================================ -->

    <Style x:Key="BottomSelectSeparatorBoxView"
           TargetType="BoxView">
        <Setter Property="HeightRequest" Value="0.5" />
        <Setter Property="Color" Value="{StaticResource GrayLighten1}" />
    </Style>

    <Style x:Key="BottomSelectGrid"
           TargetType="Grid">
        <Setter Property="BackgroundColor" Value="White" />
    </Style>

    <Style x:Key="BottomSelectImage"
           TargetType="Image">
        <Setter Property="WidthRequest" Value="48" />
        <Setter Property="HeightRequest" Value="48" />
    </Style>

    <Style x:Key="BottomSelectLabel"
           TargetType="Label">
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- Bottom select badge -->
    <Style x:Key="BottomSelectBadgeBorder"
           TargetType="Border">
        <Setter Property="VerticalOptions" Value="Start" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="WidthRequest" Value="20" />
        <Setter Property="HeightRequest" Value="20" />
        <Setter Property="TranslationX" Value="20" />
        <Setter Property="TranslationY" Value="4" />
        <Setter Property="BackgroundColor" Value="{StaticResource OrangeDefault}" />
        <Setter Property="StrokeShape" Value="Ellipse" />
        <Setter Property="StrokeThickness" Value="0" />
    </Style>

    <Style x:Key="BottomSelectBadgeLabel"
           TargetType="Label">
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
    </Style>

    <!-- Center button -->
    <Style x:Key="CenterButton"
           TargetType="Button">
        <Setter Property="WidthRequest" Value="72" />
        <Setter Property="HeightRequest" Value="72" />
        <Setter Property="Padding" Value="0,6,0,0" />
        <Setter Property="TranslationY" Value="-12" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="VerticalOptions" Value="End" />
        <Setter Property="CornerRadius" Value="36" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="BackgroundColor" Value="{StaticResource PinkDefault}" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="ContentLayout" Value="Top, 0" />
        <Setter Property="behaviors:ButtonOption.PressEffect" Value="True" />
    </Style>

    <!-- Web error -->
    <Style x:Key="WebErrorGrid"
           TargetType="Grid">
        <Setter Property="Padding" Value="24" />
        <Setter Property="BackgroundColor" Value="White" />
    </Style>

    <Style x:Key="WebErrorStack"
           TargetType="VerticalStackLayout">
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="Spacing" Value="12" />
    </Style>

    <Style x:Key="WebErrorTitleLabel"
           TargetType="Label">
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource GrayDarken3}" />
    </Style>

    <Style x:Key="WebErrorMessageLabel"
           TargetType="Label">
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" Value="{StaticResource GrayDarken3}" />
    </Style>

    <Style x:Key="WebErrorDetailLabel"
           TargetType="Label">
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextColor" Value="{StaticResource GrayDefault}" />
    </Style>

    <Style x:Key="WebErrorButton"
           TargetType="Button">
        <Setter Property="Margin" Value="0,12,0,0" />
        <Setter Property="HeightRequest" Value="44" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="BackgroundColor" Value="{StaticResource PinkDefault}" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="FontSize" Value="16" />
    </Style>

    <Style x:Key="WebErrorSubButton"
           TargetType="Button">
        <Setter Property="HeightRequest" Value="44" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="BorderColor" Value="{StaticResource PinkDefault}" />
        <Setter Property="BackgroundColor" Value="White" />
        <Setter Property="TextColor" Value="{StaticResource PinkDefault}" />
        <Setter Property="FontSize" Value="16" />
    </Style>

</ResourceDictionary>
